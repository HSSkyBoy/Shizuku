<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Light" />

    <style name="Card">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
    </style>

    <style name="Card.Light" />

    <style name="CardButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CardButton.Primary" parent="CardButton">
        <item name="android:textColor">?colorOnPrimary</item>
        <item name="backgroundTint">?colorPrimary</item>
        <item name="iconTint">?colorOnPrimary</item>
    </style>

    <style name="CardButton.Secondary" parent="CardButton">
        <item name="android:textColor">?colorOnSecondaryContainer</item>
        <item name="backgroundTint">?colorSecondaryContainer</item>
        <item name="iconTint">?colorOnSecondaryContainer</item>
    </style>

    <style name="CardButton.Tertiary" parent="CardButton">
        <item name="android:textColor">?colorOnTertiaryContainer</item>
        <item name="backgroundTint">?colorTertiaryContainer</item>
        <item name="iconTint">?colorOnTertiaryContainer</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">?textAppearanceTitleMedium</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="CardSummary">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="CardContent">
        <item name="android:textAppearance">?textAppearanceBodyLarge</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="CardIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_circle_icon_background</item>
        <item name="android:tint">?colorOnTertiaryContainer</item>
        <item name="android:tintMode">src_in</item>
        <item name="android:backgroundTint">?colorTertiaryContainer</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>

    <style name="Widget.Shizuku.HomeCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-2dp</item>
        <item name="android:layout_marginEnd">-2dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/home_card_background_color</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Shizuku.HomeToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">?colorOnSurface</item>
        <item name="subtitleTextColor">?colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Shizuku.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Shizuku.PreferenceTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Shizuku.PreferenceSummary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="GrantPermissions" parent="@style/AppTheme">
        <item name="android:colorBackground">?colorBackgroundFloating</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="TerminalTutorialText">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="FilledCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-4dp</item>
        <item name="android:layout_marginEnd">-4dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="contentPaddingStart">24dp</item>
        <item name="contentPaddingEnd">24dp</item>
        <item name="contentPaddingLeft">24dp</item>
        <item name="contentPaddingRight">24dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerHigh</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AppListItemCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerLow</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AppListTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppListSummary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="TerminalStepCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerLow</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPaddingStart">18dp</item>
        <item name="contentPaddingEnd">18dp</item>
        <item name="contentPaddingTop">16dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <style name="TutorialCalloutCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerHigh</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPaddingStart">24dp</item>
        <item name="contentPaddingEnd">24dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
    </style>

    <style name="TutorialErrorCard" parent="@style/TutorialCalloutCard">
        <item name="cardBackgroundColor">?colorErrorContainer</item>
        <item name="strokeColor">?colorError</item>
    </style>

    <style name="MonoOutputCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerLow</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPaddingStart">20dp</item>
        <item name="contentPaddingEnd">20dp</item>
        <item name="contentPaddingTop">18dp</item>
        <item name="contentPaddingBottom">18dp</item>
    </style>

    <style name="DialogScrollCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerHigh</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPaddingStart">20dp</item>
        <item name="contentPaddingEnd">20dp</item>
        <item name="contentPaddingTop">18dp</item>
        <item name="contentPaddingBottom">18dp</item>
    </style>

    <style name="GrantPermissionsButtons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?textColorOnPrimaryContainer</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GrantPermissionsButtons.Top">
        <item name="android:background">@drawable/grant_permissions_buttons_top</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="GrantPermissionsButtons.Center">
        <item name="android:background">@drawable/grant_permissions_buttons_center</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="GrantPermissionsButtons.Buttom">
        <item name="android:background">@drawable/grant_permissions_buttons_bottom</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

</resources>
